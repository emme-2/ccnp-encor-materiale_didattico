! =============================================================================
! CCNP ENCOR 350-401 — MOD-19: DMVPN Phase 1, Phase 2 & Phase 3
! Router: HUB
! Role:   DMVPN Hub / VRF PE
! Snapshot: Fine MOD-18 (IPSec IKEv2 configurato su Tu101/Tu102)
! =============================================================================
! STATO CUST-B:
!   Bug-1 CORRETTO — Lo2 ip address 10.2.1.1
!   Bug-2 CORRETTO — Tu202 tunnel source Loopback0
!   Tu210 BUG-3 ANCORA PRESENTE — manca tunnel mode gre multipoint (fix in MOD-19 T5.9)
! STATO CUST-A:
!   VRF + Lo1 + Tu101/Tu102 GRE P2P + route statiche + IKEv2/IPSec completo
!   tunnel protection ipsec profile IPSEC-PROF applicato su Tu101 e Tu102
! NON PRESENTE:
!   Tu110 DMVPN CUST-A — configurato dagli studenti in MOD-19 (Part 5)
!   Named EIGRP — configurato dagli studenti in MOD-19 (Part 6)
! =============================================================================

hostname HUB

! -----------------------------------------------------------------------------
! UNDERLAY — global table
! -----------------------------------------------------------------------------
interface Loopback0
 description !! Tunnel source — global table
 ip address 192.0.2.254 255.255.255.255
 no shutdown
!
interface Ethernet0/0.10
 description !! ISP link — VLAN 10 — 192.0.2.0/30
 encapsulation dot1Q 10
 ip address 192.0.2.2 255.255.255.252
!
ip route 0.0.0.0 0.0.0.0 192.0.2.1

! =============================================================================
! VRF CUST-B — bug 1 e 2 corretti; Tu210 bug-3 ancora presente
! =============================================================================
vrf definition CUST-B
 description !! Customer B
 rd 2:1
 address-family ipv4
 exit-address-family
!
interface Loopback2
 description !! VRF CUST-B customer loopback
 vrf forwarding CUST-B
 ip address 10.2.1.1 255.255.255.255
!
interface Tunnel201
 description !! GRE CUST-B HUB<->SP1
 vrf forwarding CUST-B
 ip address 172.16.201.1 255.255.255.252
 tunnel source Loopback0
 tunnel destination 198.51.100.254
 tunnel mode gre ip
 no shutdown
!
interface Tunnel202
 description !! GRE CUST-B HUB<->SP2
 vrf forwarding CUST-B
 ip address 172.16.202.1 255.255.255.252
 tunnel source Loopback0
 tunnel destination 203.0.113.254
 tunnel mode gre ip
 no shutdown
!
ip route vrf CUST-B 10.2.2.1 255.255.255.255 Tunnel201
ip route vrf CUST-B 10.2.3.1 255.255.255.255 Tunnel202
!
! Tu210 CUST-B — BUG-3 ANCORA PRESENTE (manca tunnel mode gre multipoint)
! Gli studenti trovano e correggono questo bug in MOD-19 Task T5.9
interface Tunnel210
 description !! DMVPN CUST-B cloud — HUB — BUG: missing tunnel mode gre multipoint
 vrf forwarding CUST-B
 ip address 172.16.210.1 255.255.255.0
 tunnel source Loopback0
 ! tunnel mode gre multipoint  <-- INTENTIONALLY OMITTED (BUG-3 — fix in MOD-19)
 ip nhrp network-id 210
 ip nhrp map multicast dynamic
 ip nhrp redirect
 no shutdown

! =============================================================================
! VRF CUST-A — GRE P2P + IPSec completo (fine MOD-18)
! =============================================================================
vrf definition CUST-A
 description !! Customer A
 rd 1:1
 address-family ipv4
 exit-address-family
!
interface Loopback1
 description !! VRF CUST-A customer loopback
 vrf forwarding CUST-A
 ip address 10.1.1.1 255.255.255.255
!
! Tu101 e Tu102: GRE P2P con tunnel protection IPSec attiva
! Gli studenti eseguono shutdown in MOD-19 T5.1 prima di creare Tu110
interface Tunnel101
 description !! GRE CUST-A HUB<->SP1 — IPSec attiva
 vrf forwarding CUST-A
 ip address 172.16.101.1 255.255.255.252
 tunnel source Loopback0
 tunnel destination 198.51.100.254
 tunnel mode gre ip
 tunnel protection ipsec profile IPSEC-PROF
 no shutdown
!
interface Tunnel102
 description !! GRE CUST-A HUB<->SP2 — IPSec attiva
 vrf forwarding CUST-A
 ip address 172.16.102.1 255.255.255.252
 tunnel source Loopback0
 tunnel destination 203.0.113.254
 tunnel mode gre ip
 tunnel protection ipsec profile IPSEC-PROF
 no shutdown
!
ip route vrf CUST-A 10.1.2.1 255.255.255.255 Tunnel101
ip route vrf CUST-A 10.1.3.1 255.255.255.255 Tunnel102

! =============================================================================
! IPSEC / IKEv2 — configurato dagli studenti in MOD-18
! =============================================================================
crypto ikev2 proposal PROP-ENCOR
 encryption aes-cbc-256
 integrity sha256
 group 14
!
crypto ikev2 policy POL-ENCOR
 proposal PROP-ENCOR
!
! Keyring HUB: peer SP1 e SP2 identificati per Lo0 (NBMA address)
crypto ikev2 keyring KR-ENCOR
 peer SP1
  address 198.51.100.254
  pre-shared-key cisco123
 !
 peer SP2
  address 203.0.113.254
  pre-shared-key cisco123
!
crypto ikev2 profile PROF-ENCOR
 match identity remote address 198.51.100.254 255.255.255.255
 match identity remote address 203.0.113.254 255.255.255.255
 authentication remote pre-share
 authentication local pre-share
 keyring local KR-ENCOR
!
crypto ipsec transform-set TS-ENCOR esp-aes 256 esp-sha256-hmac
 mode tunnel
!
crypto ipsec profile IPSEC-PROF
 set transform-set TS-ENCOR
 set ikev2-profile PROF-ENCOR
!
! VERIFY pre-lab MOD-19:
!   show crypto ipsec sa | include encaps|decaps
!   ping vrf CUST-A 10.1.2.1 source Loopback1  ! SP1 Lo1
!   ping vrf CUST-A 10.1.3.1 source Loopback1  ! SP2 Lo1
!   show crypto isakmp sa                        ! atteso: QM_IDLE x2
!   show ip interface brief | include Tunnel
end
