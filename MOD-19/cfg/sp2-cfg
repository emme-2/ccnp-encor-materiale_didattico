! =============================================================================
! CCNP ENCOR 350-401 — MOD-19: DMVPN Phase 1, Phase 2 & Phase 3
! Router: SP2 (Spoke 2)
! Role:   DMVPN Spoke / VRF CE  —  IPSec REFERENCE (pre-configurato)
! Snapshot: Fine MOD-18 — SP2 invariato (non modificato in MOD-18)
! =============================================================================
! STATO CUST-B:
!   Sempre corretto (non-Tu210)
!   Tu210 BUG-4 ANCORA PRESENTE — nhrp nhs 172.16.210.2 (fix in MOD-19 T5.9)
! STATO CUST-A:
!   Lo1 + Tu102 GRE + IKEv2/IPSec pre-configurati (reference)
!   Route statiche CUST-A configurate dagli studenti in MOD-17 Part 3
! NOTA PER DOCENTE:
!   SP2 non viene modificato in MOD-18 — e' gia' completo come reference
!   In MOD-19 gli studenti configurano Tu110 (Part 5) ed EIGRP (Part 6)
! =============================================================================

hostname SP2

! -----------------------------------------------------------------------------
! UNDERLAY — global table
! -----------------------------------------------------------------------------
interface Loopback0
 description !! Tunnel source — global table
 ip address 203.0.113.254 255.255.255.255
 no shutdown
!
interface Ethernet0/0.30
 description !! ISP link — VLAN 30 — 203.0.113.0/30
 encapsulation dot1Q 30
 ip address 203.0.113.2 255.255.255.252
!
ip route 0.0.0.0 0.0.0.0 203.0.113.1

! =============================================================================
! VRF CUST-B — sempre corretto su SP2
! =============================================================================
vrf definition CUST-B
 description !! Customer B — corretto su SP2
 rd 2:3
 address-family ipv4
 exit-address-family
!
interface Loopback2
 description !! VRF CUST-B customer loopback
 vrf forwarding CUST-B
 ip address 10.2.3.1 255.255.255.255
!
interface Tunnel202
 description !! GRE CUST-B SP2<->HUB
 vrf forwarding CUST-B
 ip address 172.16.202.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 no shutdown
!
ip route vrf CUST-B 10.2.1.1 255.255.255.255 Tunnel202
ip route vrf CUST-B 10.2.2.1 255.255.255.255 Tunnel202
!
! Tu210 CUST-B — BUG-4 ANCORA PRESENTE (nhrp nhs .2 invece di .1)
! Gli studenti trovano e correggono questo bug in MOD-19 Task T5.9
interface Tunnel210
 description !! DMVPN CUST-B cloud — SP2 spoke — BUG: wrong NHS IP
 vrf forwarding CUST-B
 ip address 172.16.210.12 255.255.255.0
 tunnel source Loopback0
 tunnel mode gre multipoint
 ip nhrp network-id 210
 ip nhrp nhs 172.16.210.2
 ip nhrp map 172.16.210.2 203.0.113.254
 ip nhrp map multicast 203.0.113.254
 ip nhrp shortcut
 no shutdown

! =============================================================================
! VRF CUST-A — pre-configurato come reference
! =============================================================================
vrf definition CUST-A
 description !! Customer A — SP2 pre-configurato come IPSec reference
 rd 1:3
 address-family ipv4
 exit-address-family
!
interface Loopback1
 description !! VRF CUST-A customer loopback
 vrf forwarding CUST-A
 ip address 10.1.3.1 255.255.255.255
!
interface Tunnel102
 description !! GRE CUST-A SP2<->HUB — IPSec pre-applicata (reference)
 vrf forwarding CUST-A
 ip address 172.16.102.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 tunnel protection ipsec profile IPSEC-PROF
 no shutdown
!
ip route vrf CUST-A 10.1.1.1 255.255.255.255 Tunnel102
ip route vrf CUST-A 10.1.2.1 255.255.255.255 Tunnel102

! =============================================================================
! IPSEC / IKEv2 — pre-configurato come reference
! =============================================================================
crypto ikev2 proposal PROP-ENCOR
 encryption aes-cbc-256
 integrity sha256
 group 14
!
crypto ikev2 policy POL-ENCOR
 proposal PROP-ENCOR
!
crypto ikev2 keyring KR-ENCOR
 peer HUB
  address 192.0.2.254
  pre-shared-key cisco123
 !
 peer SP1
  address 198.51.100.254
  pre-shared-key cisco123
!
crypto ikev2 profile PROF-ENCOR
 match identity remote address 192.0.2.254 255.255.255.255
 match identity remote address 198.51.100.254 255.255.255.255
 authentication remote pre-share
 authentication local pre-share
 keyring local KR-ENCOR
!
crypto ipsec transform-set TS-ENCOR esp-aes 256 esp-sha256-hmac
 mode tunnel
!
crypto ipsec profile IPSEC-PROF
 set transform-set TS-ENCOR
 set ikev2-profile PROF-ENCOR
!
! VERIFY pre-lab MOD-19:
!   show crypto ipsec sa | include encaps|decaps
!   ping vrf CUST-A 10.1.1.1 source Loopback1  ! HUB Lo1
!   ping vrf CUST-A 10.1.2.1 source Loopback1  ! SP1 Lo1 (via HUB)
!   show crypto isakmp sa                        ! QM_IDLE dopo primo ping
end
