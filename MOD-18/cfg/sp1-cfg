! =============================================================================
! CCNP ENCOR 350-401 — MOD-18: IPSec IKEv2 & VTI
! Router: SP1 (Spoke 1)
! Role:   DMVPN Spoke / VRF CE
! Snapshot: Fine MOD-17 (Parts 1-3 completi)
! =============================================================================
! STATO CUST-B:
!   Bug-1 CORRETTO — Lo2 ha vrf forwarding CUST-B + ip address 10.2.2.1
!   Bug-2 CORRETTO — Tu201 tunnel destination 192.0.2.254 (era 203.0.113.254)
!   Tu210 BUG-3 ANCORA PRESENTE — nhrp network-id 211 invece di 210 (fix in MOD-19 T5.9)
! STATO CUST-A:
!   Configurato dagli studenti in MOD-17: VRF + Lo1 + Tu101 GRE P2P + route statiche
! NON PRESENTE:
!   IPSec/IKEv2 — configurato dagli studenti in MOD-18
!   Tu110 DMVPN CUST-A — configurato dagli studenti in MOD-19
! =============================================================================

hostname SP1

! -----------------------------------------------------------------------------
! UNDERLAY — global table
! -----------------------------------------------------------------------------
interface Loopback0
 description !! Tunnel source — global table
 ip address 198.51.100.254 255.255.255.255
 no shutdown
!
interface Ethernet0/0.20
 description !! ISP link — VLAN 20 — 198.51.100.0/30
 encapsulation dot1Q 20
 ip address 198.51.100.2 255.255.255.252
!
ip route 0.0.0.0 0.0.0.0 198.51.100.1

! =============================================================================
! VRF CUST-B — bug 1 e 2 corretti dagli studenti in MOD-17 Parts 1-2
! =============================================================================
vrf definition CUST-B
 description !! Customer B
 rd 2:2
 address-family ipv4
 exit-address-family
!
! [Bug-1 CORRETTO] Lo2: aggiunto vrf forwarding CUST-B
interface Loopback2
 description !! VRF CUST-B customer loopback
 vrf forwarding CUST-B
 ip address 10.2.2.1 255.255.255.255
!
! [Bug-2 CORRETTO] Tu201: tunnel destination 192.0.2.254 (era 203.0.113.254)
interface Tunnel201
 description !! GRE CUST-B SP1<->HUB
 vrf forwarding CUST-B
 ip address 172.16.201.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 no shutdown
!
ip route vrf CUST-B 10.2.1.1 255.255.255.255 Tunnel201
ip route vrf CUST-B 10.2.3.1 255.255.255.255 Tunnel201
!
! Tu210 CUST-B — BUG-3 ANCORA PRESENTE (nhrp network-id 211 invece di 210)
! Gli studenti trovano e correggono questo bug in MOD-19 Task T5.9
interface Tunnel210
 description !! DMVPN CUST-B cloud — SP1 spoke — BUG: wrong nhrp network-id
 vrf forwarding CUST-B
 ip address 172.16.210.11 255.255.255.0
 tunnel source Loopback0
 tunnel mode gre multipoint
 ip nhrp network-id 211
 ip nhrp nhs 172.16.210.1
 ip nhrp map 172.16.210.1 192.0.2.254
 ip nhrp map multicast 192.0.2.254
 ip nhrp shortcut
 no shutdown

! =============================================================================
! VRF CUST-A — configurato dagli studenti in MOD-17 Parts 1-3
! =============================================================================
vrf definition CUST-A
 description !! Customer A
 rd 1:2
 address-family ipv4
 exit-address-family
!
interface Loopback1
 description !! VRF CUST-A customer loopback
 vrf forwarding CUST-A
 ip address 10.1.2.1 255.255.255.255
!
interface Tunnel101
 description !! GRE CUST-A SP1<->HUB — senza IPSec (aggiunto in MOD-18)
 vrf forwarding CUST-A
 ip address 172.16.101.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 no shutdown
!
ip route vrf CUST-A 10.1.1.1 255.255.255.255 Tunnel101
ip route vrf CUST-A 10.1.3.1 255.255.255.255 Tunnel101
!
! VERIFY pre-lab MOD-18:
!   ping 192.0.2.2               ! HUB underlay
!   ping 203.0.113.2             ! SP2 underlay
!   ping vrf CUST-A 10.1.1.1 source Loopback1  ! HUB Lo1
!   ping vrf CUST-A 10.1.3.1 source Loopback1  ! SP2 Lo1 (via HUB)
!   show crypto ikev2 sa         ! atteso: vuoto
end
