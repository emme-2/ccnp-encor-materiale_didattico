! CCNP ENCOR 350-401 v1.2  —  LAB 06  —  Virtualizzazione & Overlay
! Router: SP2 (Spoke 2)
! Role:   DMVPN Spoke / VRF CE  —  IPSec REFERENCE (pre-configured)
! TFTP:   192.168.122.1/ENCOR/LAB06/sp2-cfg
! Load:   copy tftp://192.168.122.1/ENCOR/LAB06/sp2-cfg running-config
! =============================================================================
! PRE-CONFIGURED (CUST-B):
!   [PART 1] Lo2 VRF CUST-B        — correct
!   [PART 2] Tu202 GRE CUST-B      — correct
!   [PART 3] Static routes CUST-B  — correct
!   [PART 5] Tu210 DMVPN CUST-B    — BUG: nhrp nhs wrong IP (.2 vs .1)
! PRE-CONFIGURED (CUST-A — IPSec reference for Part 4):
!   [PART 2] Tu102 GRE CUST-A     — correct (no IPSec yet at Part 2)
!   [PART 4] IKEv2 full config     — correct (students examine as reference)
!            IPSec profile + tunnel protection on Tu102
! CONFIGURED BY STUDENTS (CUST-A — later Parts):
!   [PART 5] Tu110 DMVPN CUST-A
!   [PART 6] Named EIGRP CUST-A/CUST-B
! =============================================================================

hostname SP2

! -----------------------------------------------------------------------------
! UNDERLAY — global table
! -----------------------------------------------------------------------------
interface Loopback0
 description !! Tunnel source — global table
 ip address 203.0.113.254 255.255.255.255
 no shutdown
!
interface Ethernet0/0.30
 description !! ISP link — VLAN 30 — 203.0.113.0/30
 encapsulation dot1Q 30
 ip address 203.0.113.2 255.255.255.252
!
ip route 0.0.0.0 0.0.0.0 203.0.113.1

! ============================================================================
! VRF CUST-B  —  PRE-CONFIGURED (CORRECT)
! ============================================================================

vrf definition CUST-B
 description !! Customer B — fully correct on SP2
 rd 2:3
 address-family ipv4
 exit-address-family
!
! [PART 1]  Lo2 — correct
interface Loopback2
 description !! VRF CUST-B customer loopback
 vrf forwarding CUST-B
 ip address 10.2.3.1 255.255.255.255
!
! [PART 2]  Tu202 GRE CUST-B — correct
interface Tunnel202
 description !! GRE CUST-B SP2<->HUB — correct
 vrf forwarding CUST-B
 ip address 172.16.202.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 no shutdown
!
! [PART 3]  Static routes CUST-B — correct
ip route vrf CUST-B 10.2.1.1 255.255.255.255 Tunnel202
ip route vrf CUST-B 10.2.2.1 255.255.255.255 Tunnel202
!
! -----------------------------------------------------------------------------
! [PART 5]  DMVPN cloud CUST-B — SP2 spoke
! *** BUG-4 [Part 5]: ip nhrp nhs 172.16.210.2 instead of 172.16.210.1
!                     AND ip nhrp map points to .2 (SP1 tunnel IP, not HUB)
!                     SP2 tries to register with a non-existent NHS.
!                     Tunnel stays UP (GRE) but NHRP never completes.
!     DIAGNOSIS: show ip nhrp           (no entries — registration fails)
!                show dmvpn             (NHRP: 0 peers)
!                HUB# show ip nhrp      (SP2 absent)
!     FIX: interface Tunnel210
!            ip nhrp nhs 172.16.210.1
!            no ip nhrp map 172.16.210.2 203.0.113.254   (remove wrong entry)
!            ip nhrp map 172.16.210.1 192.0.2.254         (add correct entry)
!            ip nhrp map multicast 192.0.2.254             (fix multicast map)
! -----------------------------------------------------------------------------
interface Tunnel210
 description !! DMVPN CUST-B cloud — SP2 spoke — BUG: wrong NHS IP
 vrf forwarding CUST-B
 ip address 172.16.210.12 255.255.255.0
 tunnel source Loopback0
 tunnel mode gre multipoint
 ip nhrp network-id 210
 ip nhrp nhs 172.16.210.2
 ip nhrp map 172.16.210.2 203.0.113.254
 ip nhrp map multicast 203.0.113.254
 ip nhrp shortcut
 no shutdown
!
! ============================================================================
! VRF CUST-A  —  PRE-CONFIGURED (IPSec reference for Part 4)
! ============================================================================

vrf definition CUST-A
 description !! Customer A — SP2 pre-configured as IPSec reference
 rd 1:3
 address-family ipv4
 exit-address-family
!
! [PART 1/2]  Lo1 + Tu102 — pre-configured so students can examine
!             IPSec applied at Part 4 level
interface Loopback1
 description !! VRF CUST-A customer loopback
 vrf forwarding CUST-A
 ip address 10.1.3.1 255.255.255.255
!
! [PART 2]  Tu102 GRE CUST-A — pre-configured (without protection initially)
!           tunnel protection is ALREADY applied here as the reference
!           Students examine this in Part 4 before replicating on HUB/SP1
interface Tunnel102
 description !! GRE CUST-A SP2<->HUB  —  REFERENCE: IPSec pre-applied
 vrf forwarding CUST-A
 ip address 172.16.102.2 255.255.255.252
 tunnel source Loopback0
 tunnel destination 192.0.2.254
 tunnel mode gre ip
 tunnel protection ipsec profile IPSEC-PROF
 no shutdown
!
! ============================================================================
! IPSEC / IKEv2  —  PRE-CONFIGURED (REFERENCE for Part 4)
! Students examine this config on SP2 BEFORE configuring HUB and SP1.
! ============================================================================

! -----------------------------------------------------------------------------
! IKEv2 Proposal — encryption and integrity algorithms
! -----------------------------------------------------------------------------
crypto ikev2 proposal PROP-ENCOR
 encryption aes-cbc-256
 integrity sha256
 group 14
!
! -----------------------------------------------------------------------------
! IKEv2 Policy — binds proposal to IKEv2 negotiation
! -----------------------------------------------------------------------------
crypto ikev2 policy POL-ENCOR
 proposal PROP-ENCOR
!
! -----------------------------------------------------------------------------
! IKEv2 Keyring — pre-shared keys per peer (identified by NBMA/Lo0 IP)
!   SP2 peers with HUB (192.0.2.254) and SP1 (198.51.100.254)
! -----------------------------------------------------------------------------
crypto ikev2 keyring KR-ENCOR
 peer HUB
  address 192.0.2.254
  pre-shared-key cisco123
 !
 peer SP1
  address 198.51.100.254
  pre-shared-key cisco123
!
! -----------------------------------------------------------------------------
! IKEv2 Profile — matches peer identity, references keyring
!   match identity remote address: matches by peer's NBMA IP (Lo0)
! -----------------------------------------------------------------------------
crypto ikev2 profile PROF-ENCOR
 match identity remote address 192.0.2.254 255.255.255.255
 match identity remote address 198.51.100.254 255.255.255.255
 authentication remote pre-share
 authentication local pre-share
 keyring local KR-ENCOR
!
! -----------------------------------------------------------------------------
! IPSec Transform-Set — defines ESP encryption + integrity algorithms
!   mode tunnel: encrypts entire original IP packet (standard for GRE+IPSec)
! -----------------------------------------------------------------------------
crypto ipsec transform-set TS-ENCOR esp-aes 256 esp-sha256-hmac
 mode tunnel
!
! -----------------------------------------------------------------------------
! IPSec Profile — links transform-set and IKEv2 profile
!   Applied to tunnel interface via "tunnel protection ipsec profile"
!   This is the VTI (Virtual Tunnel Interface) method — replaces crypto map
! -----------------------------------------------------------------------------
crypto ipsec profile IPSEC-PROF
 set transform-set TS-ENCOR
 set ikev2-profile PROF-ENCOR
!
